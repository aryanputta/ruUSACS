# Azure Maps credentials
AZURE_MAPS_SUBSCRIPTION_KEY=your-azure-maps-subscription-key-here
AZURE_MAPS_CLIENT_ID=your-azure-maps-client-id-here
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com

# Azure Communication Service
AZURE_COMMUNICATION_CONNECTION_STRING=your-azure-communication-connection-string-here

# Server configuration
PORT=4000

# CORS – comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
