# ============================================================
# AZURE KEYS - KEEP THIS FILE SECRET, NEVER COMMIT TO GIT
# ============================================================
# Copy this file to .env and fill in your real keys
# The .gitignore ensures .env is never pushed to GitHub

# Azure AD B2C (for user authentication)
AZURE_AD_B2C_TENANT_ID=your-tenant-id-here
AZURE_AD_B2C_CLIENT_ID=your-client-id-here
AZURE_AD_B2C_CLIENT_SECRET=your-client-secret-here

# Azure Communication Service (for chat/messaging)
AZURE_COMMUNICATION_CONNECTION_STRING=your-communication-connection-string-here

# Azure Maps (for navigation/location)
AZURE_MAPS_SUBSCRIPTION_KEY=your-azure-maps-subscription-key-here
AZURE_MAPS_CLIENT_ID=your-azure-maps-client-id-here
AZURE_MAPS_BASE_URL=https://atlas.microsoft.com

# Azure Notification Hubs (for push notifications)
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=your-notification-hub-connection-string-here
AZURE_NOTIFICATION_HUB_NAME=your-notification-hub-name-here

# Azure App Insights (for analytics)
AZURE_APP_INSIGHTS_CONNECTION_STRING=your-app-insights-connection-string-here

# Server configuration
PORT=4000

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
